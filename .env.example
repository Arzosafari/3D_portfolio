# Optional frontend configuration. The mock provider is the default and needs no API key.
VITE_AI_PROVIDER=mock
VITE_AI_API_BASE=/api/ai

# Put provider credentials in your backend's private environment, never in VITE_* variables.
# The server talks to any OpenAI-compatible endpoint; pick it with AI_BASE_URL/AI_MODEL
# (see .env.base44-defaults) and supply the key as AI_API_KEY:
#   OpenRouter -> https://openrouter.ai/keys
#   Groq       -> https://console.groq.com/keys
# AI_API_KEY=
