# Plain (non-secret) defaults for the AI service. Real credentials are delivered
# by the platform to /run/base44/app.env, which compose lists AFTER this file so
# the user's values always win. Never put a secret in this file.
#
# AI_BASE_URL: any OpenAI-compatible endpoint ({base}/chat/completions).
# AI_MODEL:    the model that endpoint should run.
#
# Default provider: OpenRouter — one key, many models (https://openrouter.ai/keys).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# To run the AI Lab on Groq instead, swap the two lines above for:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
# and store that provider's key as AI_API_KEY (https://console.groq.com/keys).
